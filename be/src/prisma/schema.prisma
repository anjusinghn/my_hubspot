generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Deal {
  id         Int       @id @default(autoincrement())
  name       String
  amount     String?
  stage      String    @default("new")
  owner      String?
  closeDate  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model MeetingLink {
  id        Int      @id @default(autoincrement())
  title     String
  duration  String
  createdBy String
  slug      String   @unique
  createdAt DateTime @default(now())
}

model BookedMeeting {
  id            Int      @id @default(autoincrement())
  title         String
  attendeeName  String
  attendeeEmail String
  scheduledDate DateTime
  duration      String
  linkUsed      String?
  description   String?
  createdAt     DateTime @default(now())
