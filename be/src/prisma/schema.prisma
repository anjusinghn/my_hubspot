generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Deal {
  id         Int       @id @default(autoincrement())
  name       String
  amount     String?
  stage      String    @default("new")
  owner      String?
  closeDate  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

